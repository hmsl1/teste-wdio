{
  "name": "teste-wdio",
  "type": "module",
  "devDependencies": {
    "@wdio/appium-service": "^9.29.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "appium": "^3.5.2",
    "appium-uiautomator2-driver": "^8.1.0",
    "kill-port": "^2.0.1",
    "start-server-and-test": "^3.0.11"
  },
  "scripts": {
    "pretest": "kill-port 4723",
    "start-appium": "appium --base-path / --port 4723 --allow-insecure uiautomator2:chromedriver_autodownload --log-level debug --log appium.log",
    "wdio": "wdio run ./wdio.conf.js",
    "test": "start-server-and-test start-appium http://127.0.0.1:4723/status wdio"
  }
}
